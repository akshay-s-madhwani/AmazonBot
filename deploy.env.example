# Copy to deploy.env at the repository root. Never commit the filled-in file.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEPLOY_SECRET=
DEPLOY_REPOSITORY=akshay-s-madhwani/AmazonBot
# Fine-grained token: Actions read for the bot repo. Git uses its own credentials.
DEPLOY_GITHUB_TOKEN=
# Loopback by default: expose ONLY the webhook through an HTTPS reverse proxy.
DEPLOY_HOST=127.0.0.1
DEPLOY_PORT=7901
DEPLOY_MANAGER_PORT=7800
# Wait for work to finish; abort the deployment if it remains busy.
DEPLOY_DRAIN_TIMEOUT_MS=900000
